<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false"
        app:singleLine="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipConstitution"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Constitution" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLaw"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laws" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBylaw"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bylaws" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCase"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Court practice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPractice"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Legal practice" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <Button android:id="@+id/btnStarred" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_starred" />
        <Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_history" />
        <Button android:id="@+id/btnNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_notes" />
        <Button android:id="@+id/btnBookmarks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_bookmarks" />
        <Button android:id="@+id/btnCollections" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_collections" />
        <Button android:id="@+id/btnSavedSearches" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_saved_searches" />
        <Button android:id="@+id/btnImportExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_import_export" />
        <Button android:id="@+id/btnTemplates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_templates" />
        <Button android:id="@+id/btnChecklists" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_checklists" />
        <Button android:id="@+id/btnDockets" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_dockets" />
    </LinearLayout>

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnOpenSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Search"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/docsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:text="Docs: 0"/>

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="No documents yet."
        android:visibility="gone"/>

</LinearLayout>
